# dependencies
node_modules/

# Expo
.expo/
dist/
web-build/
expo-env.d.ts

# Native
.kotlin/
*.orig.*
*.jks
*.p8
*.p12
*.key
*.mobileprovision

# Keystore is committed on purpose (private, solo-dev repo, used for backup) —
# see plugins/withReleaseSigning.js, which reads credentials.json during
# `expo prebuild` to re-wire release signing every time android/ is regenerated.
!credentials/android/keystore.jks

# Metro
.metro-health-check*

# debug
npm-debug.*
yarn-debug.*
yarn-error.*

# macOS
.DS_Store
*.pem

# local env files
.env*.local

# typescript
*.tsbuildinfo

example

# generated native folders
/ios
/android
