# Firebase connection settings for the mobile app.
#
# This file IS committed on purpose. None of these values are secrets — they
# just say which Firebase project to talk to. Your data is protected by the
# Firestore security rules, not by hiding these.
#
# Never put a real secret (payment keys, admin credentials) in a variable that
# starts with EXPO_PUBLIC_ — anything with that prefix is baked into the app and
# can be read by anyone who downloads it. Secrets belong in Cloud Functions.
#
# After changing anything here, fully reload the app (press "r" in the Expo
# terminal). Editing this file alone won't update an app that's already running.

# Which backend to use. You normally don't edit this by hand — the npm scripts
# set it for you:
#
#   npm start            -> emulators on your computer  (this default)
#   npm run start:cloud  -> the real REPLACE-WITH-NEW-PROJECT-ID project
#
# Ignored entirely in a release build, which always uses the cloud.
EXPO_PUBLIC_USE_EMULATOR=true

# --- Real cloud project (REPLACE-WITH-NEW-PROJECT-ID) -------------------------------------
# Only used by `npm run start:cloud` and by real app builds.
#
# These come from the "NewOldWorld POS" Web app registered in the Firebase console.
# To re-read them at any time:
#   cd firebase && npx firebase apps:sdkconfig WEB --project REPLACE-WITH-NEW-PROJECT-ID

EXPO_PUBLIC_FIREBASE_API_KEY=
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=REPLACE-WITH-NEW-PROJECT-ID.firebaseapp.com
EXPO_PUBLIC_FIREBASE_PROJECT_ID=REPLACE-WITH-NEW-PROJECT-ID
EXPO_PUBLIC_FIREBASE_STORAGE_BUCKET=REPLACE-WITH-NEW-PROJECT-ID.firebasestorage.app
EXPO_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
EXPO_PUBLIC_FIREBASE_APP_ID=

# --- App Check (Play Integrity) ---------------------------------------------
# Debug-only. Real (production) builds never read this — see the __DEV__
# check in src/lib/firebase.ts, which always uses Play Integrity there instead.
#
# Lets a local dev-client build pass App Check without a real Play Integrity
# attestation. Register one at: Firebase console > App Check > Apps >
# (the Android app) > manage debug tokens. Leave blank until App Check is
# actually registered for this app in the console — local dev works fine
# without it, it just won't attest.
EXPO_PUBLIC_APP_CHECK_DEBUG_TOKEN=
