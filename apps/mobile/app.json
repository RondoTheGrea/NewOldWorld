{
  "expo": {
    "name": "NewOldWorld",
    "slug": "newoldworld",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "newoldworld",
    "userInterfaceStyle": "light",
    "ios": {
      "icon": "./assets/expo.icon"
    },
    "android": {
      "versionCode": 1,
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.ronaldean.newoldworld",
      "googleServicesFile": "./google-services.json",
      "permissions": [
        "android.permission.BLUETOOTH",
        "android.permission.BLUETOOTH_ADMIN",
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.BLUETOOTH_CONNECT",
        "android.permission.BLUETOOTH_SCAN",
        "android.permission.BLUETOOTH_ADVERTISE"
      ]
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#ffffff",
          "image": "./assets/images/splash-transparent.png",
          "imageWidth": 1
        }
      ],
      "expo-font",
      "with-rn-bluetooth-classic",
      "expo-sqlite",
      [
        "expo-image-picker",
        {
          "cameraPermission": "Allow NewOldWorld to access your camera to attach payment proof photos.",
          "microphonePermission": false
        }
      ],
      "./plugins/withReleaseSigning.js",
      "@react-native-firebase/app",
      "@react-native-firebase/app-check"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "7ccaeff7-ed02-4840-b902-ed8b945bb31e"
      }
    }
  }
}
