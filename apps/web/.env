# Firebase connection settings for the web dashboard.
#
# This file IS committed on purpose. None of these values are secrets — they
# just say which Firebase project to talk to. Your data is protected by the
# Firestore security rules, not by hiding these.
#
# Never put a real secret (payment keys, admin credentials) in a variable that
# starts with VITE_ — anything with that prefix is baked into the built JS and
# can be read by anyone who loads the page. Secrets belong in Cloud Functions.

# Which backend to use in local dev. You normally don't edit this by hand —
# the npm scripts pick the mode for you:
#
#   npm run dev        -> emulators on your computer  (this default)
#   npm run dev:cloud   -> the real newoldworld-b8f5d project (see .env.cloud)
#
# Ignored entirely in a production build, which always uses the cloud —
# see the import.meta.env.DEV check in src/lib/firebase.ts.
VITE_USE_EMULATOR=true

# --- Real cloud project (newoldworld-b8f5d) -------------------------------------
# Same Firebase project and same "NewOldWorld POS" Web app config the mobile app
# uses — one Firebase Web app registration is shared by every web-based
# surface, native apps register separately. To re-read these at any time:
#   cd firebase && npx firebase apps:sdkconfig WEB --project newoldworld-b8f5d

VITE_FIREBASE_API_KEY=AIzaSyBrPmu_67_xOnc9Irf5D0S_vOPlGBdLJDI
VITE_FIREBASE_AUTH_DOMAIN=newoldworld-b8f5d.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=newoldworld-b8f5d
VITE_FIREBASE_STORAGE_BUCKET=newoldworld-b8f5d.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=626354182259
VITE_FIREBASE_APP_ID=1:626354182259:web:a09f31236b521e4bddb206

# --- App Check (reCAPTCHA Enterprise) ---------------------------------------
# Register this web app at: Firebase console > App Check > Apps > register
# app > reCAPTCHA Enterprise (Firebase can auto-create the key for you there,
# no separate Google Cloud Console visit needed). Paste the resulting site
# key below. Leave blank and the dashboard still runs fine in dev (see
# src/lib/firebase.ts) — it just won't attest, same as before this existed.
VITE_RECAPTCHA_SITE_KEY=6LfJ19wtAAAAAEV9Zs9KyFvTLWkg7gmIoG1znqEC

# Debug-only, for local dev — bypasses reCAPTCHA entirely so localhost
# doesn't need to be registered with the real site key. Register one at:
# Firebase console > App Check > Apps > manage debug tokens. Leave blank and
# the browser console will log a fresh one for you to go register instead.
VITE_APP_CHECK_DEBUG_TOKEN=BC93C3C5-AE0E-403D-9B11-CCD62FEF3033
